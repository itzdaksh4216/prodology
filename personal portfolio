@style.css
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #222;
}


/* NAVIGATION */

.navbar {
    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 18px 8%;

    background: #24105f;

    z-index: 1000;
}

.logo {
    color: white;

    font-size: 28px;

    font-weight: bold;
}

.nav-links {
    display: flex;

    list-style: none;

    gap: 25px;
}

.nav-links a {
    color: white;

    text-decoration: none;

    font-size: 16px;

    transition: 0.3s;
}

.nav-links a:hover {
    color: #00ffff;
}


/* HOME */

.hero {
    min-height: 100vh;

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 120px 10% 60px;

    background:
        linear-gradient(
            135deg,
            #24105f,
            #1769aa
        );

    color: white;
}

.hero-text {
    max-width: 600px;
}

.welcome {
    font-size: 22px;
}

.hero h1 {
    font-size: 60px;

    margin: 10px 0;
}

.hero h2 {
    font-size: 32px;

    color: #00ffff;

    margin-bottom: 20px;
}

.hero-text > p {
    font-size: 18px;

    line-height: 1.6;

    margin-bottom: 25px;
}

.btn {
    display: inline-block;

    padding: 14px 25px;

    background: #00ffff;

    color: #24105f;

    text-decoration: none;

    border-radius: 25px;

    font-weight: bold;

    transition: 0.3s;
}

.btn:hover {
    transform: scale(1.05);

    background: white;
}


/* PROFILE IMAGE */

.hero-image img {
    width: 280px;

    height: 280px;

    object-fit: cover;

    border-radius: 50%;

    border: 6px solid white;

    box-shadow:
        0 0 30px rgba(255,255,255,0.4);
}


/* GENERAL SECTIONS */

.section {
    min-height: 70vh;

    padding: 100px 10%;

    text-align: center;
}

.section h2 {
    font-size: 40px;

    margin-bottom: 40px;

    color: #24105f;
}


/* ABOUT */

.about-content {
    max-width: 800px;

    margin: auto;

    font-size: 18px;

    line-height: 1.8;
}

.about-content p {
    margin-bottom: 20px;
}


/* SKILLS */

.skills-container {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;
}

.skill {
    padding: 30px;

    background: white;

    border-radius: 15px;

    box-shadow:
        0 5px 20px rgba(0,0,0,0.1);

    transition: 0.3s;
}

.skill:hover {
    transform: translateY(-8px);
}

.skill h3 {
    color: #1769aa;

    margin-bottom: 10px;
}


/* EDUCATION */

.education-card {
    max-width: 600px;

    margin: auto;

    padding: 35px;

    background: white;

    border-radius: 15px;

    box-shadow:
        0 5px 20px rgba(0,0,0,0.1);
}

.education-card h3 {
    color: #1769aa;

    font-size: 25px;

    margin-bottom: 15px;
}


/* PROJECTS */

.projects-container {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;
}

.project-card {
    background: white;

    padding: 30px;

    border-radius: 15px;

    box-shadow:
        0 5px 20px rgba(0,0,0,0.1);

    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-8px);
}

.project-card h3 {
    color: #24105f;

    margin-bottom: 15px;
}

.project-card p {
    line-height: 1.6;

    margin-bottom: 20px;
}

.project-card button {
    padding: 10px 20px;

    border: none;

    border-radius: 20px;

    background: #24105f;

    color: white;

    cursor: pointer;
}


/* ACHIEVEMENTS */

.achievement-container {
    display: flex;

    justify-content: center;

    gap: 30px;
}

.achievement {
    max-width: 350px;

    padding: 30px;

    background: white;

    border-radius: 15px;

    box-shadow:
        0 5px 20px rgba(0,0,0,0.1);
}

.achievement h3 {
    color: #1769aa;

    margin-bottom: 10px;
}


/* CONTACT */

#contactForm {
    max-width: 600px;

    margin: auto;

    display: flex;

    flex-direction: column;

    gap: 15px;
}

#contactForm input,
#contactForm textarea {
    padding: 15px;

    border: 1px solid #ccc;

    border-radius: 8px;

    font-size: 16px;
}

#contactForm textarea {
    height: 150px;

    resize: none;
}

#contactForm button {
    padding: 14px;

    border: none;

    border-radius: 8px;

    background: #24105f;

    color: white;

    font-size: 17px;

    cursor: pointer;
}


/* FOOTER */

footer {
    padding: 25px;

    text-align: center;

    background: #24105f;

    color: white;
}


/* RESPONSIVE DESIGN */

@media (max-width: 800px) {

    .navbar {
        flex-direction: column;

        gap: 15px;
    }

    .nav-links {
        gap: 12px;

        flex-wrap: wrap;

        justify-content: center;
    }

    .hero {
        flex-direction: column;

        text-align: center;

        gap: 40px;
    }

    .hero h1 {
        font-size: 42px;
    }

    .skills-container,
    .projects-container {
        grid-template-columns: 1fr;
    }

    .achievement-container {
        flex-direction: column;

        align-items: center;
    }

}


@media (max-width: 500px) {

    .hero {
        padding: 140px 20px 60px;
    }

    .hero h1 {
        font-size: 35px;
    }

    .hero h2 {
        font-size: 24px;
    }


    .hero-image img {
        width: 200px;

        height: 200px;
    }

    .section {
        padding: 80px 20px;
    }

}
