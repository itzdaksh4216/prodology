        <h2>Contact Us</h2>
        <p>Email: example@gmail.com</p>
    </section>


    <script src="script.js"></script>

</body>
#script.js
const navbar = document.getElementById("navbar");

window.addEventListener("scroll", function() {

    if (window.scrollY > 50) {
        navbar.style.backgroundColor = "#24105f";
        navbar.style.padding = "15px 50px";
    } 
    else {
        navbar.style.backgroundColor = "transparent";
        navbar.style.padding = "20px 50px";
    }

});
#style.css
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
}
#navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px 50px;

    background-color: transparent;

    transition: 0.4s;

    z-index: 1000;
}
.logo {
    font-size: 28px;
    font-weight: bold;
    color: white;
}
#navbar ul {
    display: flex;
    list-style: none;
    gap: 30px;
}

#navbar ul li a {
    text-decoration: none;
    color: white;
    font-size: 18px;

    transition: 0.3s;
}
#navbar ul li a:hover {
    color: yellow;
}
#navbar ul li a:hover {
    color: #00ffff;
    transform: scale(1.1);
}
.hero {
    height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    background: linear-gradient(
        135deg,
        #24105f,
        #1769aa
    );

    color: white;
}

.hero h1 {
    font-size: 55px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 25px;
    margin-bottom: 30px;
}

.hero button {
    padding: 15px 30px;
    border: none;
    border-radius: 25px;

    background-color: white;
    color: #24105f;

    font-size: 18px;
    cursor: pointer;

    transition: 0.3s;
}

.hero button:hover {
    background-color: #00ffff;
    transform: scale(1.1);
}
section:not(.hero) {
    min-height: 100vh;

    padding: 120px 50px;

    text-align: center;

    background-color: #f5f5f5;
}

section h2 {
    font-size: 40px;
    margin-bottom: 20px;
}

section p {
    font-size: 18px;
    line-height: 1.6;
}
.cards {
    display: flex;
    justify-content: center;
    gap: 30px;

    margin-top: 50px;
}

.card {
    width: 280px;

    padding: 30px;

    background-color: white;

    border-radius: 15px;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);

    transition: 0.3s;
}

.card:hover {
    transform: translateY(-10px);
}
@media (max-width: 768px) {

    #navbar {
        padding: 15px 20px;
        flex-direction: column;
        gap: 10px;
    }

    .logo {
        font-size: 22px;
    }

    #navbar ul {
        gap: 15px;
    }

    #navbar ul li a {
        font-size: 14px;
    }

    .hero h1 {
        font-size: 35px;
    }

    .hero p {
        font-size: 20px;
    }

    .cards {
        flex-direction: column;
        align-items: center;
    }

    .card {
        width: 90%;
    }
}
</html>
